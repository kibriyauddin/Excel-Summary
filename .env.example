# Server-only provider credentials. Never prefix these with VITE_.
GEMINI_API_KEY=your_gemini_api_key_here
SUPADATA_API_KEY=your_supadata_api_key_here

# Comma-separated frontend origins allowed by the API in production.
CORS_ORIGIN=http://localhost:5173

# Public Supabase client configuration. Protect all tables with Row Level Security.
VITE_SUPABASE_URL=your_supabase_project_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Set only if the API is deployed on a different origin from the frontend.
# VITE_API_BASE_URL=https://your-api.example.com
